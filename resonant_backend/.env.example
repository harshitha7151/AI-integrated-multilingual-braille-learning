# Copy values into your local environment; never put real credentials in version control.
ENV=development
RESONANT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# JWT secret for signing teacher tokens (Required: server fails at startup if missing)
RESONANT_JWT_SECRET=your-secure-random-secret-key-min-32-chars

# AI & LLM Service
RESONANT_OLLAMA_URL=http://localhost:11434
RESONANT_OLLAMA_MODEL=qwen2.5:0.5b
RESONANT_AI_ENABLED=true

# Optional trusted local artifact for the isolated public-dataset experiment.
# Never point this at a user upload; joblib artifacts can execute code on load.
RESONANT_EDUCATIONAL_ML_ARTIFACT=../aiml/artifacts/assistments_2009_rf_v1.joblib

# Optional qualified Resonant next-attempt artifact. The service accepts only
# trusted repository artifact directories and fails to deterministic cold-start
# unless the artifact declares consented data, exact schema/task compatibility,
# passing gates, supported languages, and explicit human review.
RESONANT_ML_ARTIFACT=../aiml/artifacts/resonant_next_attempt_v2.joblib
RESONANT_ML_LOW_RISK_THRESHOLD=0.25
RESONANT_ML_HIGH_RISK_THRESHOLD=0.55

# Optional constrained question rephrasing. Production assessment selection is
# currently deterministic and does not enable this path.
RESONANT_ADAPTIVE_AI_QUESTIONS=false
RESONANT_ADAPTIVE_AI_COOLDOWN_SECONDS=20
RESONANT_ADAPTIVE_AI_TIMEOUT_SECONDS=4

# Allowed CORS origins (comma-separated, e.g. http://localhost:8000,http://10.0.2.2:8000)
RESONANT_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
